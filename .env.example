# PressingPro CI fonctionne encore sans backend : sans ces variables,
# l’application conserve ses données locales dans le navigateur.
#
# Pour activer progressivement le client Supabase (Auth/PostgREST),
# copiez ce fichier en .env.local puis renseignez la clé publique du projet.
# Ne mettez jamais de clé secrète/service_role dans une variable VITE_.
VITE_SUPABASE_URL=https://phjstsydxvggtduohfrl.supabase.co
VITE_SUPABASE_ANON_KEY=remplacer-par-la-cle-publique-anon-ou-publishable
