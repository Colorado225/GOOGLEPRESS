VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBoanN0c3lkeHZnZ3RkdW9oZnJsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI3NzE2MzgsImV4cCI6MjEwODM0NzYzOH0.G0i5fnxtiyMyW76ZhLlh63yKNTsbSjY00eAPt_BxGAU

# Démonstration locale explicite en développement uniquement. Elle n’est jamais
# disponible dans un build de production. Laissez false ou absent pour exiger
# une session Supabase et un rattachement actif.
# Ne jamais activer ce mode sur un poste contenant des données réelles.
VITE_ALLOW_LOCAL_DEMO=false
